{
  "name": "triggerboxd-preview",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-opennext-preview-props.mjs",
    "build:worker": "node scripts/patch-opennext-preview-props.mjs && opennextjs-cloudflare build",
    "preview:worker": "wrangler dev --local --ip 127.0.0.1 --port 4328 --var APP_ORIGIN:http://127.0.0.1:4328",
    "test": "node --test tests/api/*.test.mjs tests/auth/*.test.mjs tests/contracts/*.test.mjs tests/tmdb/*.test.mjs tests/ui/*.test.mjs",
    "test:db": "node supabase/tests/run.mjs node_modules/@electric-sql/pglite/dist/index.js",
    "test:smoke": "node --test tests/e2e/runtime.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@opennextjs/cloudflare": "1.20.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3",
    "wrangler": "4.149.0"
  }
}
