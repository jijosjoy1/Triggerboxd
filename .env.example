# Public Supabase project identifiers; never use a secret/service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Set through Worker secrets for a future deployment.
SUPABASE_SECRET_KEY=
TMDB_READ_ACCESS_TOKEN=
REQUEST_HASH_SECRET=

# Exact site origin; local development example. Change for staging/production.
APP_ORIGIN=http://127.0.0.1:4327
ENABLE_GOOGLE_AUTH=true
# Enable only after confirmation and password-recovery mail delivery is verified.
ENABLE_PASSWORD_AUTH=false

# Owner alerts: Resend sending-only key and a verified sender, server-side only.
EMAIL_API_KEY=
EMAIL_FROM=
# Generate a random value of at least 32 characters. Never expose in client code.
INTERNAL_DISPATCH_SECRET=
